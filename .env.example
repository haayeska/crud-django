# Copie para as variáveis de ambiente antes de publicar o projeto.
# Sem elas, o projeto roda em modo de desenvolvimento.

# Gere uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 0 desliga o modo de depuração (obrigatório em produção)
DJANGO_DEBUG=1

# Domínios aceitos, separados por vírgula
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
